---
/**
 * The provider wall, rendered ENTIRELY ON THE SERVER.
 *
 * This was a React island first, and that was a mistake worth recording: the
 * 124 marks were inlined twice — once into the SSR'd HTML, again into the
 * client bundle so the island could hydrate — which took the page from 96 KB
 * to 271 KB of gzipped JavaScript.
 *
 * Astro emits the markup once and the search is ~15 lines of vanilla DOM, so
 * the interactivity costs essentially nothing. Filtering by attribute means no
 * framework needs to own this state.
 */
const RAW = import.meta.glob("../assets/logos/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

/**
 * A CURATED selection, not all 124 marks.
 *
 * Inlining every one cost 182 KB of gzipped HTML for a single section — more
 * than the rest of the page combined. It also sold worse: a wall containing
 * changedetection, karakeep and miniflux reads as noise, while one containing
 * Gmail, Slack, Notion and Stripe reads as "it already works with my stuff".
 *
 * The 100+ claim is made in the heading; this is the evidence for it, not an
 * inventory. The full list belongs in the documentation.
 */
const FEATURED = [
  "google", "google_calendar", "google_drive", "google_sheets", "google_docs",
  "notion", "slack", "github", "discord", "telegram", "outlook", "teams",
  "dropbox", "jira", "asana", "trello", "clickup", "monday", "airtable",
  "hubspot", "salesforce", "stripe", "shopify", "mailchimp", "sendgrid",
  "zendesk", "intercom", "twilio", "calendly", "todoist", "spotify", "youtube",
  "reddit", "x", "linkedin", "facebook", "instagram", "mastodon", "bluesky",
  "threads", "tiktok", "pinterest", "google_analytics", "google_ads",
  "home_assistant", "immich", "nextcloud", "grafana", "n8n", "gitea",
  "jellyfin", "strava", "readwise", "wikipedia",
];

const byName = new Map(
  Object.entries(RAW).map(([path, svg]) => [
    (path.split("/").pop() ?? "").replace(".svg", ""),
    svg,
  ]),
);

const logos = FEATURED.filter((n) => byName.has(n)).map((n) => ({
  name: n.replace(/_/g, " "),
  svg: byName.get(n)!,
}));

const remaining = byName.size - logos.length;
---

<div class="mx-auto w-full max-w-5xl">
  <div class="relative mx-auto mb-8 max-w-sm">
    <svg
      class="absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-stone/60"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
    </svg>
    <input
      id="conn-search"
      type="search"
      placeholder="Search services…"
      aria-label="Search connected services"
      autocomplete="off"
      class="w-full rounded-full border border-line bg-paper py-2.5 pr-4 pl-10 text-[14px] text-bark transition-colors outline-none placeholder:text-stone/60 focus:border-ember/50"
    />
  </div>

  <div id="conn-grid" class="grid grid-cols-[repeat(auto-fill,minmax(56px,1fr))] gap-2.5 sm:gap-3">
    {
      logos.map((l) => (
        <div
          data-name={l.name}
          title={l.name}
          class="conn-tile group grid aspect-square place-items-center rounded-xl border border-line/70 bg-white text-[#18181b] shadow-[0_1px_2px_rgba(33,29,26,0.05)] transition-all duration-200 hover:-translate-y-0.5 hover:border-ember/40 hover:shadow-[0_8px_20px_-8px_rgba(169,76,28,0.45)]"
        >
          <span
            class="[&>svg]:size-[22px] [&>svg]:transition-transform [&>svg]:duration-200 group-hover:[&>svg]:scale-110"
            set:html={l.svg}
          />
        </div>
      ))
    }
  </div>

  <p id="conn-empty" class="hidden py-10 text-center text-[14px] text-stone">
    Not in this selection — it may still be supported. See the full list in the docs.
  </p>

  <p class="mt-8 text-center text-[14px] text-stone">
    …and {remaining} more.{" "}
    <a
      href="/docs/getting-started/what-rookery-is"
      class="font-medium text-ember underline decoration-ember/30 underline-offset-2 hover:decoration-ember"
      >See them all</a
    >
  </p>
</div>

<script>
  const input = document.getElementById("conn-search") as HTMLInputElement | null;
  const grid = document.getElementById("conn-grid");
  const empty = document.getElementById("conn-empty");
  if (input && grid && empty) {
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>(".conn-tile"));
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const t of tiles) {
        const hit = !q || (t.dataset.name ?? "").includes(q);
        t.hidden = !hit;
        if (hit) shown++;
      }
      empty.classList.toggle("hidden", shown > 0);
    });
  }
</script>
