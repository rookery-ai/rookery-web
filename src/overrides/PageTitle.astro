---
/**
 * Overrides Starlight's PageTitle to prefix the heading with the page's icon.
 *
 * Mirrors the upstream component (an <h1> carrying Starlight's own id, so the
 * skip link and "back to top" still resolve) and adds a `data-icon` span
 * painted by the generated mask CSS. A page opts in with one frontmatter line:
 *
 *   icon: agents
 *
 * Keys come from scripts/gen-doc-icons.mjs and are the same lucide glyphs the
 * landing page uses. A page without an icon renders exactly as before.
 */
const { title, icon } = Astro.locals.starlightRoute.entry.data as {
  title: string;
  icon?: string;
};
---

<h1 id="_top">
  {icon && <span class="title-icon" data-icon={icon} aria-hidden="true" />}
  <span>{title}</span>
</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
      display: flex;
      align-items: center;
      gap: 0.5em;
    }
  }

  /* Sized against the heading rather than a fixed px value, so it scales with
     the type scale instead of drifting out of proportion. */
  .title-icon {
    font-size: 0.78em;
    color: var(--sl-color-accent);
    flex: none;
  }
</style>
