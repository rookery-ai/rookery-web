---
import "../styles/brand.css";
import InstallBlock from "../components/InstallBlock.tsx";
import Transcript from "../components/Transcript.tsx";
import AIActionsDemo from "../components/AIActionsDemo.tsx";
import LogoWall from "../components/LogoWall.astro";
import SkillsBento from "../components/SkillsBento.tsx";
import NotificationDemo from "../components/NotificationDemo.tsx";
import ModelChips from "../components/ModelChips.tsx";
import {
  WorkspacesVisual,
  AgentsVisual,
  SecretsVisual,
  ChatVisual,
  ScheduleVisual,
} from "../components/FeatureVisual.tsx";
import { GithubIcon } from "../components/icons.tsx";
import {
  ArrowRight,
  BookOpen,
  BookText,
  Layers,
  Bot,
  MessagesSquare,
  KeyRound,
  CalendarClock,
} from "lucide-react";

const title = "Rookery — your knowledge grew hands";
const description =
  "Rookery runs agents on your own machine — around the clock. They read and write your knowledge, reach the apps you already use, and tell you the moment something happens.";

/**
 * A CURATED selection of the connection marks, not all 124.
 *
 * Inlining every one cost 182 KB of gzipped HTML for one section — more than
 * the rest of the page combined — and sold worse: a wall containing
 * changedetection and karakeep reads as noise, while one containing Gmail,
 * Slack, Notion and Stripe reads as "this already works with my stuff".
 */
const CONNECTION_SLUGS = [
  "google", "google_calendar", "google_drive", "google_sheets", "google_docs",
  "notion", "slack", "github", "discord", "telegram", "outlook", "teams",
  "dropbox", "jira", "asana", "trello", "clickup", "monday", "airtable",
  "hubspot", "salesforce", "stripe", "shopify", "mailchimp", "sendgrid",
  "zendesk", "intercom", "twilio", "calendly", "todoist", "spotify", "youtube",
  "reddit", "x", "linkedin", "facebook", "instagram", "mastodon", "bluesky",
  "threads", "tiktok", "pinterest", "google_analytics", "google_ads",
  "home_assistant", "immich", "nextcloud", "grafana", "n8n", "gitea",
  "jellyfin", "strava", "readwise", "wikipedia",
];
const CONNECTIONS = CONNECTION_SLUGS.map((slug) => ({ slug }));

/**
 * The CLI coders Rookery can drive. Labelled explicitly because several of
 * these marks are ambiguous alone: OpenCode's is a plain black block and
 * Anthropic's is a bare corporate glyph, so unlabelled they read as wrong.
 * Cursor is supported but no mark is vendored for it.
 */
const CODERS = [
  { slug: "anthropic", label: "Claude Code" },
  { slug: "openai", label: "Codex" },
  { slug: "opencode_zen", label: "OpenCode" },
  { slug: "gemini", label: "Gemini CLI" },
];

/** Hosted model providers — a selection; the docs carry the current list. */
const PROVIDERS = [
  { slug: "openai", label: "OpenAI" }, { slug: "anthropic", label: "Anthropic" },
  { slug: "gemini", label: "Gemini" }, { slug: "xai", label: "xAI" },
  { slug: "mistral", label: "Mistral" }, { slug: "deepseek", label: "DeepSeek" },
  { slug: "moonshot", label: "Moonshot" }, { slug: "zai", label: "Z.AI" },
  { slug: "openrouter", label: "OpenRouter" }, { slug: "perplexity", label: "Perplexity" },
  { slug: "groq", label: "Groq" }, { slug: "together", label: "Together" },
  { slug: "fireworks", label: "Fireworks" }, { slug: "cerebras", label: "Cerebras" },
  { slug: "sambanova", label: "SambaNova" }, { slug: "nebius", label: "Nebius" },
  { slug: "deepinfra", label: "DeepInfra" }, { slug: "huggingface", label: "Hugging Face" },
  { slug: "github_models", label: "GitHub Models" }, { slug: "bedrock", label: "Bedrock" },
  { slug: "alibaba", label: "Alibaba" }, { slug: "ollama", label: "Ollama Cloud" },
];

/** Runs on your own hardware — no key, nothing leaves the network. */
const SELF_HOSTED = [
  { slug: "ollama_local", label: "Ollama" }, { slug: "lmstudio", label: "LM Studio" },
  { slug: "llamacpp", label: "llama.cpp" }, { slug: "vllm", label: "vLLM" },
  { slug: "localai", label: "LocalAI" }, { slug: "jan", label: "Jan" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="overflow-x-hidden">
    <!-- Nav -->
    <header class="sticky top-0 z-50 border-b border-line/60 bg-bone/70 backdrop-blur-xl">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5"
        aria-label="Main"
      >
        <a href="/" class="flex items-center gap-2.5 text-bark">
          <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
            <path
              d="M11 8.5h10M7.5 14h17M4.5 19.5C4.5 26 9.5 29 16 29S27.5 26 27.5 19.5"
              fill="none"
              stroke="currentColor"
              stroke-width="3.1"
              stroke-linecap="round"></path>
          </svg>
          <span class="font-mono text-[17px] font-semibold tracking-[-0.05em]">rookery</span>
        </a>
        <div class="flex items-center gap-2 text-[14px]">
          <a
            href="/docs/getting-started/what-rookery-is"
            class="flex items-center gap-2 rounded-lg px-3.5 py-2 text-[15px] text-stone transition-colors hover:bg-bark/5 hover:text-bark"
          >
            <BookOpen className="size-[20px]" /> Docs
          </a>
          <a
            href="https://github.com/ilijad1/rookery"
            class="flex items-center gap-2 rounded-lg bg-bark px-4 py-2 text-[15px] font-medium text-bone transition-opacity hover:opacity-90"
          >
            <GithubIcon className="size-[20px]" /> GitHub
          </a>
        </div>
      </nav>
    </header>

    <!-- Hero -->
    <section class="relative isolate overflow-hidden">
      <!-- Dusk aurora: the one ambient flourish, behind everything. -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-40 -right-32 -z-10 size-[46rem] rounded-full bg-[radial-gradient(circle,rgba(70,64,90,0.22),transparent_65%)] blur-3xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-52 -left-40 -z-10 size-[38rem] rounded-full bg-[radial-gradient(circle,rgba(169,76,28,0.14),transparent_65%)] blur-3xl"
      >
      </div>

      <div class="mx-auto max-w-6xl px-6 pt-24 pb-20 sm:pt-32 sm:pb-28">
        <a
          href="https://github.com/ilijad1/rookery"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-paper/80 py-1.5 pr-3 pl-1.5 text-[12.5px] text-stone backdrop-blur transition-colors hover:border-ember/40 hover:text-bark"
        >
          <span class="rounded-full bg-ember px-2 py-0.5 text-[11px] font-semibold text-white"
            >Open source</span
          >
          Apache-2.0, self-hostable forever
          <ArrowRight className="size-3.5" />
        </a>

        <h1
          class="mt-7 max-w-[15ch] text-[clamp(2.7rem,8vw,5.5rem)] leading-[0.98] font-semibold tracking-[-0.05em] text-balance"
        >
          Your knowledge grew hands.
        </h1>
        <p
          class="mt-7 max-w-[44ch] text-[clamp(1.1rem,2.3vw,1.45rem)] leading-[1.5] text-stone"
        >
          Rookery runs agents on your own machine — around the clock.
        </p>
        <div class="mt-11">
          <InstallBlock client:load />
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section class="relative border-y border-line/60 bg-paper/50 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-12 text-center">
          <p class="font-mono text-[12px] font-medium tracking-[0.16em] text-ember uppercase">
            What it's like
          </p>
          <h2
            class="mx-auto mt-4 max-w-[18ch] text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            You describe it. It gets built and tested.
          </h2>
        </div>
        <Transcript client:visible />
      </div>
    </section>

    <!-- Features -->
    <!-- Workspaces -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-ember-soft text-ember ring-1 ring-ember/15">
              <Layers className="size-5" />
            </span>
            <span class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
              Workspaces
            </span>
          </div>
          <h2 class="mt-6 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance">
            One machine. Sealed, separate worlds.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Every workspace is its own tenant — its own knowledge, its own credentials, its
            own connected accounts, its own agents. You enter one with its password, and
            nothing crosses between them.
          </p>
          <p class="mt-6 max-w-[46ch] rounded-lg border border-line/80 bg-paper/70 px-4 py-3 text-[13.5px] leading-relaxed text-stone/90">
            On Linux, each workspace's agents are additionally confined to it at the
            filesystem level. On macOS and Windows that confinement isn't available and
            they run unconfined.
          </p>
        </div>
        <WorkspacesVisual client:visible />
      </div>
    </section>

    <!-- Knowledge base: the live AI-actions demo instead of a media panel -->
    <section class="relative py-20 sm:py-28">
      <div
        class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20"
      >
        <div class="lg:order-2">
          <div class="flex items-center gap-3">
            <span
              class="grid size-10 place-items-center rounded-xl bg-ember-soft text-ember ring-1 ring-ember/15"
            >
              <BookText className="size-5" />
            </span>
            <span
              class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase"
            >
              Knowledge base
            </span>
          </div>
          <h2
            class="mt-6 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Select a sentence. Watch it improve.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Everything you know, everything your agents learn, and what your connected
            services bring in — as plain markdown on your own disk. Open it in Rookery
            or in any editor you like.
          </p>
          <p class="mt-6 text-[13.5px] text-stone/80">Try the buttons →</p>
        </div>
        <div class="lg:order-1">
          <AIActionsDemo client:visible />
        </div>
      </div>
    </section>

    <!-- Agents -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div class="lg:order-2">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-ember-soft text-ember ring-1 ring-ember/15">
              <Bot className="size-5" />
            </span>
            <span class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
              Agents
            </span>
          </div>
          <h2 class="mt-6 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance">
            Describe it. Don't configure it.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Say what you want in your own words. Rookery asks a couple of questions,
            proposes a plan, builds it, tests it against the real services, and shows you
            what happened before anything is saved. Then it just runs.
          </p>
        </div>
        <div class="lg:order-1"><AgentsVisual client:visible /></div>
      </div>
    </section>

    <!-- Skills: bento, not a panel -->
    <section class="border-y border-line/60 bg-paper/50 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-12 max-w-[46ch]">
          <p class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
            Skills
          </p>
          <h2
            class="mt-5 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Things your agents already know how to do.
          </h2>
          <p class="mt-5 text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Built in and ready to attach to any agent — plus any you create the same
            conversational way.
          </p>
        </div>
        <SkillsBento client:visible />
      </div>
    </section>

    <!-- Connections: full-bleed wall -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-12 text-center">
          <p class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
            Connections
          </p>
          <h2
            class="mx-auto mt-5 max-w-[20ch] text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            100+ services. No middleman holding your keys.
          </h2>
          <p
            class="mx-auto mt-5 max-w-[52ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone"
          >
            Rookery talks to them directly, using credentials you own.
          </p>
        </div>
        <LogoWall
          id="conn"
          placeholder="Search services…"
          emptyText="Not in this selection — it may still be supported. See the full list in the docs."
          groups={[{ label: "Services", items: CONNECTIONS }]}
        >
          <p slot="after" class="mt-9 text-center text-[14px] text-stone">
            A selection of the 100+ supported.{" "}
            <a
              href="/docs/reference/connected-services"
              class="font-medium text-ember underline decoration-ember/30 underline-offset-2 hover:decoration-ember"
              >See them all</a
            >
          </p>
        </LogoWall>
      </div>
    </section>

    <!-- Chat -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <div class="flex items-center gap-3">
            <span
              class="grid size-10 place-items-center rounded-xl bg-ember-soft text-ember ring-1 ring-ember/15"
            >
              <MessagesSquare className="size-5" />
            </span>
            <span
              class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase"
            >
              Chat
            </span>
          </div>
          <h2
            class="mt-6 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Ask what you know. Then have it act.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Talk to your knowledge the way you'd talk to someone who has read all of it —
            and have it write a note, or do something in a connected account, right there
            in the conversation.
          </p>
        </div>
        <ChatVisual client:visible />
      </div>
    </section>

    <!-- Notifications: live demo -->
    <section class="border-y border-line/60 bg-paper/50 py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <p class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
            Notifications
          </p>
          <h2
            class="mt-5 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            You find out the moment it happens.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            An agent finished, a service returned something new, a reminder came due. It
            lands in your inbox, and reaches you on Telegram, Discord or Slack when
            you're away.
          </p>
          <p
            class="mt-6 max-w-[46ch] rounded-lg border border-line/80 bg-bone/70 px-4 py-3 text-[13.5px] leading-relaxed text-stone/90"
          >
            All three connect outbound — the bot dials out, so nothing listens on an open
            port and it works from behind a home firewall with nothing forwarded.
          </p>
        </div>
        <NotificationDemo client:visible />
      </div>
    </section>

    <!-- Models -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <p class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
            Models
          </p>
          <h2
            class="mt-5 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Your machine. Your model.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Use the coder tool you already have, or connect the provider you prefer —
            hosted, or running entirely on your own hardware. Nothing ties you to one
            vendor.
          </p>
        </div>
        <ModelChips client:visible />
      </div>
    </section>

    <!-- Secrets -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div class="lg:order-2">
          <div class="flex items-center gap-3">
            <span
              class="grid size-10 place-items-center rounded-xl bg-ember-soft text-ember ring-1 ring-ember/15"
            >
              <KeyRound className="size-5" />
            </span>
            <span
              class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase"
            >
              Secrets
            </span>
          </div>
          <h2
            class="mt-6 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Credentials that stay yours.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Encrypted where they sit, unlocked only into the thing that needs them, scoped
            to one workspace, and never handed to anyone else.
          </p>
        </div>
        <div class="lg:order-1"><SecretsVisual client:visible /></div>
      </div>
    </section>

    <!-- Scheduling -->
    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <div class="flex items-center gap-3">
            <span
              class="grid size-10 place-items-center rounded-xl bg-ember-soft text-ember ring-1 ring-ember/15"
            >
              <CalendarClock className="size-5" />
            </span>
            <span
              class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase"
            >
              Scheduling
            </span>
          </div>
          <h2
            class="mt-6 text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Every weekday at eight. And again at ten.
          </h2>
          <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone">
            Say when in your own words — twice a day, the first Monday of the month, every
            twenty minutes during work hours, or only when you ask. Reminders work the same
            way: “remind me in 10 minutes to call the doctor.”
          </p>
        </div>
        <ScheduleVisual client:visible />
      </div>
    </section>

    <!-- Models wall -->
    <section class="border-y border-line/60 bg-paper/50 py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-12 text-center">
          <p class="font-mono text-[12px] font-medium tracking-[0.16em] text-stone uppercase">
            Models
          </p>
          <h2
            class="mx-auto mt-5 max-w-[20ch] text-[clamp(2.3rem,5.4vw,3.7rem)] leading-[1.04] font-semibold tracking-[-0.04em] text-balance"
          >
            Bring the model you already trust.
          </h2>
          <p
            class="mx-auto mt-5 max-w-[52ch] text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.65] text-stone"
          >
            A coder tool you already use, a hosted provider, or a model running on your own
            hardware.
          </p>
        </div>
        <LogoWall
          id="models"
          columns={true}
          placeholder="Search models and providers…"
          emptyText="Not in this list — any OpenAI-compatible endpoint works too."
          showLabels={true}
          groups={[
            { label: "Coders", items: CODERS },
            { label: "Providers", items: PROVIDERS },
            { label: "Self-hosted", items: SELF_HOSTED },
          ]}
        />
      </div>
    </section>

    <!-- Install again -->
    <section class="relative isolate overflow-hidden border-t border-line/60 bg-paper/50 py-24 sm:py-32">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-32 left-1/2 -z-10 size-[40rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(169,76,28,0.13),transparent_65%)] blur-3xl"
      >
      </div>
      <div class="mx-auto flex max-w-6xl flex-col items-center px-6 text-center">
        <h2
          class="max-w-[18ch] text-[clamp(2rem,5vw,3.4rem)] leading-[1.04] font-semibold tracking-[-0.045em] text-balance"
        >
          Put it on a machine that never sleeps.
        </h2>
        <div class="mt-12 flex justify-center">
          <InstallBlock client:visible />
        </div>
      </div>
    </section>

    <!-- Support -->
    <section class="py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-6 text-center">
        <h2 class="text-[clamp(1.5rem,3.2vw,2.1rem)] font-semibold tracking-[-0.035em]">
          Support the project
        </h2>
        <p class="mx-auto mt-4 max-w-[52ch] text-[15.5px] leading-relaxed text-stone">
          Rookery is open source and self-hostable, forever. If it's useful to you, a
          star genuinely helps other people find it.
        </p>
        <a
          href="https://github.com/ilijad1/rookery"
