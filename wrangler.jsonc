{
  // Must equal the Worker name Terraform already created in the private infra
  // repo. A mismatch does not error — wrangler happily creates a SECOND
  // Worker that serves nothing at rookery.cloud while the deploy still
  // reports success.
  "name": "rookery-web",
  "compatibility_date": "2026-08-01",
  // The documented default is TRUE, and leaving it unset silently publishes a
  // second public copy of the whole site at rookery-web.<account>.workers.dev
  // — duplicate content at an unbranded URL that outlives any DNS change.
  // Verified live.
  // Turning this off ALSO disables per-version preview URLs — they are served
  // from the workers.dev subdomain, so there is no combination that gives
  // previews without the public alias. Verified against the live API: with
  // workers_dev off, `wrangler versions upload` emits only a Version ID and no
  // URL, and neither a `preview_urls: true` setting nor `--preview-alias`
  // changes that. Cloudflare's documentation describes them as independent
  // mechanisms; they are not. Preview deploys were dropped rather than reopen
  // the unbranded public copy — see the removed `preview` job in pr.yml.
  "workers_dev": false,
  // No `main` key: this Worker runs no code. Every request is an asset
  // request, which Cloudflare serves for free and which never counts against
  // the free plan's invocation limit.
  "assets": { "directory": "./dist" }

  // Bindings and variables belong in this file, never in Terraform — Terraform
  // owns the Worker's existence, wrangler owns its content, and wrangler's
  // config here is authoritative: it deletes any binding or variable it does
  // not declare.
}
